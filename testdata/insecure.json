{
  "ociVersion": "1.2.0",
  "process": {
    "user": { "uid": 0, "gid": 0 },
    "noNewPrivileges": false,
    "apparmorProfile": "unconfined",
    "capabilities": {
      "bounding": ["CAP_SYS_ADMIN", "CAP_SYS_MODULE", "CAP_NET_RAW"],
      "effective": ["CAP_SYS_ADMIN", "CAP_DAC_READ_SEARCH"],
      "permitted": ["CAP_SYS_ADMIN"]
    },
    "args": ["/bin/sh"]
  },
  "root": { "path": "rootfs", "readonly": false },
  "mounts": [
    {
      "destination": "/var/run/docker.sock",
      "source": "/var/run/docker.sock",
      "type": "bind",
      "options": ["rbind", "rw"]
    },
    {
      "destination": "/host",
      "source": "/",
      "type": "bind",
      "options": ["rbind", "ro"]
    }
  ],
  "linux": {
    "namespaces": [
      { "type": "mount" }
    ],
    "maskedPaths": []
  }
}
